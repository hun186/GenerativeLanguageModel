# 唯一公開的 Elasticsearch Python 連線設定範例（不含帳密）。
# 以此為範本，另存為 czjLLM/config_es/private/<YAML 指定的檔名>.py。
# 只改 private/ 下的檔案；不要提交密碼，也不要覆寫既有私人設定。
# 參見 docs/usage/es_connection_profile_examples.md（各任務索引對應表）。
#
# 下列預設採安全模式：不指定 ES 主機／索引，不套用 Mapping，
# 不強制重跑舊結果。操作員必須明確填寫並驗證。
import os

es_host = os.environ.get("CZJLLM_ES_HOST", "")
es_user = os.environ.get("CZJLLM_ES_USERNAME", "")
es_pass = os.environ.get("CZJLLM_ES_PASSWORD", "")
es_index = ""  # 按任務選擇 news_test / srp_test / fishing_test 等，不能留空

# 私有 HTTPS：應使用符合服務位址的 CA 與 TLS 主機名／IP SAN 憑證。
es_verify_certs = True
es_ssl_assert_hostname = True
# es_ca_certs = "path/to/your/trusted/http_ca.crt"

id_col = "_id"
input_col = "rawInfo.content"
output_col = "multidim_event_json"

reset_output = False
es_apply_mapping = False  # 確認索引、型別與 Mapping 後才手動開啟
mapping_file = "czjLLM/config_es/schemas/InfoExtraction-MultiDim-mapping.yaml"
only_selected = False
pending_filters = []  # 可自行設置 term/range/ids 等原生 ES DSL filter
es_prefetch_buffer = 0
es_prefetch_first_timeout = 8

# 範例只示範多維事件日期品質的非強制檢查；此處預設不啟用 rerun。
# 若主 YAML 設 rerun.enable=true，會覆寫這個 enable，並繼承未覆寫的
# required_output_checks。確切生效設定以啟動時合併後紀錄為準。
# Event 有合法日期、或 Event 明確 unknown，Timeline 皆可為空。
# 這是格式/結構檢查，不保證 LLM 沒有漏抽原文中的日期。
rerun = {
    "enable": False,
    "required_output_checks": [
        {
            "path": "multidim_event_json",
            "validator": "multidim_event_time",
            "min_valid_count": 1,
            "relative_to_output": False,
        },
    ],
}
# 需要增量重跑時，再於私人設定或任務 YAML 明確設定 pipeline_hash、
# force_since、force_if_missing_meta 等；避免照抄舊範例造成大量重算。

# =========================
# czjLLM Environment Sample
# =========================
# 優先序（低 -> 高）：
# 1) .env
# 2) .env.<CZJLLM_ENV>
# 3) .env.local
# 4) 系統環境變數（export / CI secret）最高，會覆蓋上述檔案

# 可選：指定環境名稱，會額外讀取 .env.<CZJLLM_ENV>
# CZJLLM_ENV=dev

# 全域 LLM I/O debug（可臨時打開，不必改 YAML）
CZJLLM_DEBUG_PRINT_LLM_IO=false

# 顯示字數上限；<=0 代表完整輸出
CZJLLM_DEBUG_PRINT_MAX_CHARS=2000
# Credential for the ANKInt model pool. Never write this value to ES metadata.
CZJLLM_ANKINT_API_KEY=

# Runtime credentials only: never check filled values into source control
CZJLLM_UTILS_API_KEY=
CZJLLM_SQL_ORION_PASSWORD=
CZJLLM_SQL_SRP_PASSWORD=
CZJLLM_SQL_SRP_ADMIN_PASSWORD=

# ES connection: set all three in private .env.production or secret manager.
# Omitting them uses local unauthenticated ES only; no production fallback.
CZJLLM_ES_HOST=
CZJLLM_ES_USERNAME=
CZJLLM_ES_PASSWORD=

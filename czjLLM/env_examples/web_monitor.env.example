# GLM Web Monitor settings (current per-run implementation, #395 candidate).
# Copy ONLY the relevant lines into your actual private .env/.env.<environment>/
# .env.local, or export them in the scheduled job environment.
# This example is not automatically loaded by its filename.
# Do not use per-run Web mode for concurrent scheduled jobs sharing one port.
# Central service and automatic certificates are planned, NOT implemented here.
GLM_UI_MODE=web
GLM_WEB_HOST=127.0.0.1
GLM_WEB_PORT=9010
GLM_WEB_REMOTE=off

# Optional POSIX mTLS after #395 acceptance; all three files are required.
# Keep private keys outside the repository and restrict to the service owner.
# GLM_WEB_REMOTE=mtls
# GLM_WEB_HOST=192.168.1.100
# GLM_WEB_TLS_CERT=/absolute/path/server.pem
# GLM_WEB_TLS_KEY=/absolute/path/server.key
# GLM_WEB_CLIENT_CA=/absolute/path/operator-ca.pem

# For unattended concurrent jobs before Central Monitor is implemented:
# GLM_UI_MODE=off

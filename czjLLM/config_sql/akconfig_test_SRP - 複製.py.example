# Shareable connection profile template. Copy to private/akconfig_test_SRP - 複製.py and add your complete connection values there.
# Public version contains no live credentials; private/ is excluded by Git.
import os

# czjLLM/config_sql/akconfig_test_SRP.py

# 服务器信息
server = os.environ.get("CZJLLM_SQL_SRP_SERVER") or (
    "" if os.environ.get("CZJLLM_ENV", "").strip().lower() in {"production", "prod"}
    else "localhost"
)
username = os.environ.get("CZJLLM_SQL_SRP_ADMIN_USERNAME", "")
password = os.environ.get("CZJLLM_SQL_SRP_ADMIN_PASSWORD")
# 数据库和表信息
database_name = 'Test_SRP'
table_name = 'Table_SRP'
primary_key = 'AUTO'

target_table = 'Table_SRP_LLM_result'

reset_output = False          # True 或 False，控制是否重設欄位，如果無此項設定，會進行互動詢問。
# reset_confirm_code intentionally omitted from public example